# INFO1-Stil für Datendiagramme (Pandas/Matplotlib) - passt zu info1_theme.py
# Nutzung:  plt.style.use("Grafik_Theme/info1.mplstyle")
figure.facecolor: FAFAFA
axes.facecolor: FAFAFA
savefig.facecolor: FAFAFA
font.family: DejaVu Sans
font.size: 8
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
text.color: 23373B
axes.labelcolor: 23373B
axes.edgecolor: 5A6B6E
xtick.color: 5A6B6E
ytick.color: 5A6B6E
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
axes.grid: True
axes.grid.axis: y
grid.color: DDE2E3
grid.linewidth: 0.6
axes.axisbelow: True
lines.linewidth: 2.0
lines.markersize: 5
patch.linewidth: 0
legend.frameon: False
# feste Reihenfolge; mehr als vier Reihen aufteilen statt weitere Farben erfinden
axes.prop_cycle: cycler(color=["2A78D6", "D96C0A", "0F9972", "B0408F"])
pdf.fonttype: 42
